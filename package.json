{
  "name": "brandonverzuu-monorepo",
  "version": "1.4.1",
  "description": "brandonverzuu.com and the expertise service, as npm workspaces",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/site --",
    "host": "npm run host -w apps/site --",
    "generate": "npm run generate -w apps/site --",
    "preview": "npm run preview -w apps/site --",
    "cover:generate": "npm run cover:generate -w apps/site --",
    "scrub:fingerprint": "npm run scrub:fingerprint -w apps/site --",
    "explainer:render": "npm run explainer:render -w apps/site --"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.5": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260811.1": true
  }
}
