// Gateway Worker for the expertise checks (docs/specs/expert-mcp/02-mcp-server.md).
//
// Three configurations:
// - top level: local development (`wrangler dev`) and tests. Uses in-memory stub
//   PaymentGate, Guard and RulesService (src/stubs.ts) and logs magic links to the
//   console. Named `expert-mcp-dev` and not reachable, so an accidental
//   `wrangler deploy` without `--env` can never replace staging or production.
// - env.staging / env.production: the real deployables (spec 06). Stubs are
//   never used there: anything not wired up yet fails closed.
//
// EU data location (decision D11):
// - D1: create each database with `wrangler d1 create <name> --jurisdiction eu`.
//   The jurisdiction is fixed at creation and isn't expressed in this file.
// - Durable Objects: McpSession instances are created through
//   `namespace.jurisdiction("eu")` (see src/index.ts), so their storage is EU-only.
// - KV has no jurisdiction. OAUTH_KV holds the OAuth library's grants and tokens
//   (hashed secrets, encrypted props, account ids as grant subjects) and FLAGS
//   holds non-personal flags only. See the PR for the open question on OAUTH_KV.
//
// Resource ids below are placeholders until spec 06 provisions the resources.
// Nothing here has been created in Cloudflare.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "expert-mcp-dev",
  "main": "src/index.ts",
  // Must not be newer than the workerd in package-lock.json.
  "compatibility_date": "2026-10-06",
  // nodejs_compat: the MCP SDK and the Agents SDK use Node built-ins.
  // global_fetch_strictly_public: required by the OAuth library before it fetches
  // Client ID Metadata Documents, and keeps every outbound fetch off private IPs.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Bundles products/skills into src/generated/skills.ts before dev and deploy.
  "build": {
    "command": "node scripts/bundle-skills.mjs",
    "watch_dir": "../../products/skills",
  },
  "observability": { "enabled": true },
  // src/index.ts `scheduled`:
  // - daily: expired sign-in rows, OAuth records and idempotency rows; on the 1st,
  //   last month's statements (spec 03);
  // - every 15 minutes: payments a crash left between verify and settle (voided
  //   or refunded, spec 03).
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    // Placeholder until spec 07 publishes the terms. Bumping it makes every
    // account accept the new version on its next sign-in.
    "TERMS_VERSION": "0-placeholder",
    "TERMS_URL": "https://brandonverzuu.com/expert/terms",
    "PRIVACY_URL": "https://brandonverzuu.com/expert/privacy",
    "PROCESS_SCHEMA_URL": "https://brandonverzuu.com/schemas/process-description/v1.json",
    "EMAIL_FROM": "Brandon Verzuu <expert@brandonverzuu.com>",
    // Payments (spec 03). X402_PAY_TO is Brandon's receiving address on Base:
    // public, but a placeholder until he sets it; the zero address means x402
    // isn't offered. MPP_STRIPE_NETWORK_ID is the Stripe Business Network
    // profile id (profile_...) the MPP challenge names.
    "X402_NETWORK": "base-sepolia",
    "X402_PAY_TO": "0x0000000000000000000000000000000000000000",
    "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
    "X402_FACILITATOR_KEY_ID": "",
    "MPP_STRIPE_NETWORK_ID": "",
    // "stub" (in-memory, collects nothing) or "live" (real rails, keys in .dev.vars).
    "PAYMENT_GATE": "stub",
  },
  "durable_objects": {
    "bindings": [{ "name": "MCP_SESSION", "class_name": "McpSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["McpSession"] }],
  "d1_databases": [
    {
      "binding": "COMMERCE",
      "database_name": "expert-commerce-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
    { "binding": "FLAGS", "id": "00000000000000000000000000000001" },
  ],
  // The private rules Worker (spec 04). Unused in development, where the stub
  // RulesService answers instead.
  "services": [{ "binding": "RULES", "service": "expert-rules-staging" }],

  "env": {
    "staging": {
      "name": "expert-mcp-staging",
      // Set with `wrangler secret put <NAME> --env <env>`; never in this file.
      "secrets": {
        "required": [
          "EMAIL_HMAC_KEY",
          "VARIANT_KEY",
          "PAYMENT_HMAC_KEY",
          "X402_FACILITATOR_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "GUARD_CONFIG",
        ],
      },
      "routes": [
        { "pattern": "mcp-staging.brandonverzuu.com", "custom_domain": true },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_ORIGIN": "https://mcp-staging.brandonverzuu.com",
        "TERMS_VERSION": "0-placeholder",
        "TERMS_URL": "https://brandonverzuu.com/expert/terms",
        "PRIVACY_URL": "https://brandonverzuu.com/expert/privacy",
        "PROCESS_SCHEMA_URL": "https://brandonverzuu.com/schemas/process-description/v1.json",
        "EMAIL_FROM": "Brandon Verzuu <expert@brandonverzuu.com>",
        // Payments (spec 03). X402_PAY_TO is Brandon's receiving address on Base:
        // public, but a placeholder until he sets it; the zero address means x402
        // isn't offered. MPP_STRIPE_NETWORK_ID is the Stripe Business Network
        // profile id (profile_...) the MPP challenge names.
        "X402_NETWORK": "base-sepolia",
        "X402_PAY_TO": "0x0000000000000000000000000000000000000000",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "X402_FACILITATOR_KEY_ID": "",
        "MPP_STRIPE_NETWORK_ID": "",
      },
      "durable_objects": {
        "bindings": [{ "name": "MCP_SESSION", "class_name": "McpSession" }],
      },
      "d1_databases": [
        {
          "binding": "COMMERCE",
          "database_name": "expert-commerce-staging",
          // Placeholder. Create with: wrangler d1 create expert-commerce-staging --jurisdiction eu
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "00000000000000000000000000000010" },
        { "binding": "FLAGS", "id": "00000000000000000000000000000011" },
      ],
      "services": [{ "binding": "RULES", "service": "expert-rules-staging" }],
    },
    "production": {
      "name": "expert-mcp",
      // Set with `wrangler secret put <NAME> --env <env>`; never in this file.
      "secrets": {
        "required": [
          "EMAIL_HMAC_KEY",
          "VARIANT_KEY",
          "PAYMENT_HMAC_KEY",
          "X402_FACILITATOR_KEY",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "GUARD_CONFIG",
        ],
      },
      "routes": [{ "pattern": "mcp.brandonverzuu.com", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_ORIGIN": "https://mcp.brandonverzuu.com",
        "TERMS_VERSION": "0-placeholder",
        "TERMS_URL": "https://brandonverzuu.com/expert/terms",
        "PRIVACY_URL": "https://brandonverzuu.com/expert/privacy",
        "PROCESS_SCHEMA_URL": "https://brandonverzuu.com/schemas/process-description/v1.json",
        "EMAIL_FROM": "Brandon Verzuu <expert@brandonverzuu.com>",
        // Payments (spec 03). X402_PAY_TO is Brandon's receiving address on Base:
        // public, but a placeholder until he sets it; the zero address means x402
        // isn't offered. MPP_STRIPE_NETWORK_ID is the Stripe Business Network
        // profile id (profile_...) the MPP challenge names.
        "X402_NETWORK": "base",
        "X402_PAY_TO": "0x0000000000000000000000000000000000000000",
        "X402_FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "X402_FACILITATOR_KEY_ID": "",
        "MPP_STRIPE_NETWORK_ID": "",
      },
      "durable_objects": {
        "bindings": [{ "name": "MCP_SESSION", "class_name": "McpSession" }],
      },
      "d1_databases": [
        {
          "binding": "COMMERCE",
          "database_name": "expert-commerce",
          // Placeholder. Create with: wrangler d1 create expert-commerce --jurisdiction eu
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "00000000000000000000000000000020" },
        { "binding": "FLAGS", "id": "00000000000000000000000000000021" },
      ],
      "services": [{ "binding": "RULES", "service": "expert-rules" }],
    },
  },
}
