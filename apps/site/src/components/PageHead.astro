---
// The billboard head of an index page: the breadcrumb, the title, and a lede (the description
// prop, or whatever is slotted in). Every page but the homepage carries a breadcrumb, so crumbs
// is required here. Nothing goes between the breadcrumb and the title: no kicker, label or
// subtitle. Anything extra belongs after the <h1>.
import Breadcrumb from "./Breadcrumb.astro";
import type { Crumb } from "../lib/schema";

interface Props {
  title: string;
  description?: string;
  crumbs: Crumb[];
}
const { title, description, crumbs } = Astro.props;
---

<header class="page-head wrap">
  <Breadcrumb crumbs={crumbs} />
  <h1>{title}<em>.</em></h1>
  {description && <p class="lede">{description}</p>}
  {Astro.slots.has("default") && <div class="lede"><slot /></div>}
</header>
