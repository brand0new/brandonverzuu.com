---
// Chapter 05, in numbers. Only facts the build counts from the content itself, so nothing
// here is a claim. Figures from Brandon's career join once he has approved each one.
import { siteNumbers } from "../lib/content";

const n = await siteNumbers();
const facts = [
  { value: n.articles, label: n.articles === 1 ? "article published" : "articles published" },
  { value: n.since, label: "writing since" },
  { value: n.explainers, label: n.explainers === 1 ? "animated explainer" : "animated explainers" },
  { value: n.languages, label: n.languages === 1 ? "language" : "languages" },
];
---

<section class="chapter wrap" id="numbers" aria-labelledby="numbers-title">
  <div class="chapter-head">
    <p class="label">05 · In numbers</p>
    <h2 id="numbers-title">Counted,<br />not claimed</h2>
    <p class="measure">Every figure here is counted from the site's own content when it's built.</p>
  </div>
  <dl class="facts">
    {
      facts.map((f) => (
        <div>
          <dt class="label">{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .facts > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .6rem; padding: 1.2rem 1.2rem 1.2rem 0; }
  .facts > div + div { border-left: 1px solid var(--line); padding-left: 1.2rem; }
  dd { margin: 0; font-family: var(--display); font-weight: 900; font-size: clamp(3.5rem, 2rem + 6vw, 7.5rem); line-height: .8; color: var(--accent); font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) {
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .facts > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
