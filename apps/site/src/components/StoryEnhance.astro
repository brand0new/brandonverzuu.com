---
// The story template's small behaviours, shared by articles and reviews: the chapter rail
// marks the chapter being read, the explainer plays (with a pause button), ::figure{dither}
// figures resolve as they scroll into view, and the one ==highlight== locks on.
---

<script>
  import { Source, resolve, sizeCanvas, loadImage, isDark, tok, photoTone, glitch, reduce, onTheme, observeLockOn } from "../scripts/signal.js";

  // Chapter rail.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".rail a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    let queued = false;
    const mark = () => {
      queued = false;
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top < window.innerHeight * 0.35) current = t;
      links.forEach((a, id) => (id === current.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
    };
    window.addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(mark); } }, { passive: true });
    mark();
  }

  // Explainer: plays when it comes into view unless the reader prefers reduced motion. The
  // pause button keeps the loop within WCAG 2.2.2.
  const video = document.querySelector<HTMLVideoElement>(".explainer video");
  const toggle = document.querySelector<HTMLButtonElement>(".ex-toggle");
  if (video && toggle) {
    video.muted = true;
    let userPaused = false;
    const sync = () => {
      toggle.setAttribute("aria-label", video.paused ? "Play animation" : "Pause animation");
      toggle.dataset.playing = String(!video.paused);
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.addEventListener("click", () => {
      if (video.paused) { userPaused = false; video.play().catch(() => {}); }
      else { userPaused = true; video.pause(); }
    });
    if (!reduce && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !userPaused) video.play().catch(() => {});
        else if (!e.isIntersecting) video.pause();
      }, { threshold: 0.35 }).observe(video);
    }
  }

  // ::figure{dither}: the image itself, dithered, resolving with its position on screen.
  document.querySelectorAll<HTMLElement>("[data-resolve] .fig-frame").forEach((frame) => {
    const img = frame.querySelector("img")!;
    const cv = document.createElement("canvas") as HTMLCanvasElement & { _native?: number };
    cv.className = "dither";
    cv.setAttribute("aria-hidden", "true");
    let source: ReturnType<typeof Source> | null = null;
    let locked = false;
    const draw = (force = false) => {
      if (!source) return;
      sizeCanvas(cv, frame);
      const r = frame.getBoundingClientRect();
      // Noise as it enters at the bottom, signal by the time its centre reaches the middle.
      const p = reduce ? 1 : Math.min(1, Math.max(0, (window.innerHeight - r.top) / (window.innerHeight * 0.5 + r.height / 2)));
      const n = resolve(cv, source, p, { on: tok("--dot"), off: tok("--paper"), force, tone: photoTone(isDark()) });
      if (n > 0) {
        const sig = n >= cv._native!;
        if (sig && !locked) glitch(frame.closest("figure")?.querySelector("figcaption") ?? null);
        locked = sig;
      }
    };
    loadImage(img.currentSrc || img.src).then((im) => {
      frame.style.aspectRatio = `${im.naturalWidth} / ${im.naturalHeight}`;
      frame.prepend(cv);
      frame.classList.add("live");
      sizeCanvas(cv, frame);
      const n = Math.min(im.naturalWidth, cv.width);
      source = Source(im, n, Math.max(1, Math.round((n * im.naturalHeight) / im.naturalWidth)));
      draw(true);
    });
    window.addEventListener("scroll", () => draw(), { passive: true });
    onTheme(() => draw(true));
  });

  observeLockOn(document.querySelectorAll(".prose mark"));
</script>

<style is:global>
  .explainer { margin: 0; display: flex; flex-direction: column; gap: .6rem; scroll-margin-top: calc(var(--barh) + 1rem); }
  .ex-frame { position: relative; background: #09090b; border: 1px solid var(--line); }
  .ex-frame video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .ex-toggle { position: absolute; top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 0; background: rgb(15 26 29 / .82); color: #e5eef0; cursor: pointer; }
  .ex-toggle:hover { color: #beff33; }
  .ex-toggle .i-pause, .ex-toggle[data-playing="true"] .i-play { display: none; }
  .ex-toggle[data-playing="true"] .i-pause { display: inline; }
  .prose .explainer { max-width: none; margin-block: 2em; }
</style>
