---
// The story template's small behaviours, used by articles: the chapter rail
// marks the chapter being read, the explainer plays (with a pause button), ::figure{dither}
// figures resolve as they scroll into view, and the one ==highlight== locks on.
---

<script>
  import { Source, resolve, centreFocus, sizeCanvas, loadImage, isDark, tok, photoTone, glitch, markSignal, reduce, onTheme, observeLockOn } from "../scripts/signal.js";

  // Chapter rail.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>(".rail a")].map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
  const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (targets.length) {
    const list = document.querySelector<HTMLElement>(".rail ol");
    const rail = document.querySelector<HTMLElement>(".rail.has-toc");
    const toggle = rail?.querySelector<HTMLButtonElement>(".toc-toggle");
    const countEl = rail?.querySelector<HTMLElement>(".toc-count");
    const curEl = rail?.querySelector<HTMLElement>(".toc-cur");
    const prose = document.querySelector<HTMLElement>("[data-cover-progress]");
    const ids = [...links.keys()];
    const pad = (n: number) => String(n).padStart(2, "0");
    let queued = false, shown = "";
    // When the chapter list is longer than the rail, it scrolls itself so the current chapter sits
    // in its middle. It scrolls the list only, never the page.
    const centre = (a: HTMLElement, smooth: boolean) => {
      if (!list) return;
      const v = list.scrollHeight > list.clientHeight + 1;
      list.classList.toggle("scrolls", v);
      if (!v) return;
      const r = list.getBoundingClientRect(), b = a.getBoundingClientRect();
      list.scrollBy({ top: b.top + b.height / 2 - (r.top + r.height / 2), behavior: smooth && !reduce ? "smooth" : "auto" });
    };
    const mark = (force = false) => {
      queued = false;
      let current = targets[0];
      for (const t of targets) if (t.getBoundingClientRect().top < window.innerHeight * 0.35) current = t;
      links.forEach((a, id) => (id === current.id ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      if (force || current.id !== shown) {
        centre(links.get(current.id)!, !force);
        if (countEl && curEl) {
          countEl.textContent = `${pad(ids.indexOf(current.id) + 1)}/${pad(ids.length)}`;
          curEl.textContent = links.get(current.id)!.textContent;
        }
      }
      shown = current.id;
      // Reading progress for the mobile chapter bar.
      if (rail && prose) {
        const r = prose.getBoundingClientRect(), vh = window.innerHeight;
        rail.style.setProperty("--read", String(Math.min(1, Math.max(0, (vh * 0.35 - r.top) / Math.max(1, r.height - vh * 0.65)))));
      }
    };
    // Mobile chapter bar (story.css, below 768px): the toggle opens the list as a dropdown.
    if (rail && toggle && list) {
      rail.classList.add("toc-js");
      toggle.hidden = false;
      const setOpen = (open: boolean) => {
        rail.classList.toggle("open", open);
        toggle.setAttribute("aria-expanded", String(open));
        if (open) centre(links.get(shown || ids[0])!, false);
      };
      toggle.addEventListener("click", () => setOpen(!rail.classList.contains("open")));
      list.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) setOpen(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && rail.classList.contains("open")) { setOpen(false); toggle.focus(); } });
      document.addEventListener("click", (e) => { if (!rail.contains(e.target as Node)) setOpen(false); });
    }
    window.addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(() => mark()); } }, { passive: true });
    let rt = 0;
    window.addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(() => mark(true), 120); });
    // The dock appears once the cover script has measured, which shrinks the list.
    window.addEventListener("load", () => mark(true));
    mark(true);
  }

  // Explainer: plays when it comes into view unless the reader prefers reduced motion. The
  // pause button keeps the loop within WCAG 2.2.2.
  const video = document.querySelector<HTMLVideoElement>(".explainer video");
  const toggle = document.querySelector<HTMLButtonElement>(".ex-toggle");
  if (video && toggle) {
    video.muted = true;
    let userPaused = false;
    const sync = () => {
      toggle.setAttribute("aria-label", video.paused ? "Play animation" : "Pause animation");
      toggle.dataset.playing = String(!video.paused);
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.addEventListener("click", () => {
      if (video.paused) { userPaused = false; video.play().catch(() => {}); }
      else { userPaused = true; video.pause(); }
    });
    if (!reduce && "IntersectionObserver" in window) {
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !userPaused) video.play().catch(() => {});
        else if (!e.isIntersecting) video.pause();
      }, { threshold: 0.35 }).observe(video);
    }
  }

  // ::figure{dither}: the image itself, dithered, resolving with its position on screen.
  document.querySelectorAll<HTMLElement>("[data-resolve] .fig-frame").forEach((frame) => {
    const img = frame.querySelector("img")!;
    const cv = document.createElement("canvas") as HTMLCanvasElement & { _native?: number };
    cv.className = "dither";
    cv.setAttribute("aria-hidden", "true");
    let source: ReturnType<typeof Source> | null = null;
    let photo: HTMLImageElement | null = null;
    let locked = false;
    const draw = (force = false) => {
      if (!source) return;
      sizeCanvas(cv, frame);
      // A frame wider than the first sample (after a resize) gets a finer source, up to the photo's own pixels.
      const want = Math.min(photo!.naturalWidth, cv.width);
      if (source.w < want) source = Source(photo!, want, Math.max(1, Math.round((want * photo!.naturalHeight) / photo!.naturalWidth)));
      // Noise as it enters at the bottom, signal by the time its centre reaches the middle.
      const p = reduce ? 1 : centreFocus(frame);
      const n = resolve(cv, source, p, { on: tok("--dot"), off: tok("--paper"), force, tone: photoTone(isDark()) });
      if (n > 0) {
        const sig = n >= cv._native!;
        if (sig && !locked) glitch(frame.closest("figure")?.querySelector("figcaption") ?? null);
        markSignal(frame, sig);
        locked = sig;
      }
    };
    loadImage(img.currentSrc || img.src).then((im) => {
      photo = im;
      frame.style.aspectRatio = `${im.naturalWidth} / ${im.naturalHeight}`;
      frame.prepend(cv);
      frame.classList.add("live");
      sizeCanvas(cv, frame);
      const n = Math.min(im.naturalWidth, cv.width);
      source = Source(im, n, Math.max(1, Math.round((n * im.naturalHeight) / im.naturalWidth)));
      draw(true);
    });
    window.addEventListener("scroll", () => draw(), { passive: true });
    let rt = 0;
    window.addEventListener("resize", () => { clearTimeout(rt); rt = window.setTimeout(() => draw(true), 120); });
    onTheme(() => draw(true));
  });

  observeLockOn(document.querySelectorAll(".prose mark"));
</script>

<style is:global>
  .explainer { margin: 0; display: flex; flex-direction: column; gap: .6rem; scroll-margin-top: calc(var(--barh) + 1rem); }
  .ex-frame { position: relative; background: #09090b; border: 1px solid var(--line); }
  .ex-frame video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .ex-toggle { position: absolute; top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border: 0; background: rgb(15 26 29 / .82); color: #e5eef0; cursor: pointer; }
  .ex-toggle:hover { color: #beff33; }
  .ex-toggle .i-pause, .ex-toggle[data-playing="true"] .i-play { display: none; }
  .ex-toggle[data-playing="true"] .i-pause { display: inline; }
  .prose .explainer { max-width: none; margin-block: 2em; }
</style>
