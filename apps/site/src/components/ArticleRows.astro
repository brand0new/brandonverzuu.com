---
// Articles as rows: title, date and reading time, the description, the tags. Each row carries
// its topic slugs (data-topics) for the topic filter on /articles.
import { formatDate, isoDate, readingMinutes, inCluster, type Article } from "../lib/content";
import { topicClusters } from "../lib/topicClusters";

interface Props {
  articles: Article[];
}
const { articles } = Astro.props;
---

<ul class="rows">
  {
    articles.map((a) => (
      <li data-topics={topicClusters.filter((c) => inCluster(a, c)).map((c) => c.slug).join(" ")}>
        <a class="row" href={`/articles/${a.id}`}>
          <span class="row-title">{a.data.title}</span>
          <span class="row-meta">
            <time datetime={isoDate(a.data.date)}>{formatDate(a.data.date)}</time> · {readingMinutes(a)} min
          </span>
          <span class="row-desc">{a.data.description}</span>
          {(a.data.tags ?? []).length > 0 && (
            <span class="row-tags tags">
              {(a.data.tags ?? []).map((t) => (
                <span class="tag">{t}</span>
              ))}
              {a.data.explainerVideo && <span class="tag on">▶ Explainer</span>}
            </span>
          )}
        </a>
      </li>
    ))
  }
</ul>
