---
// The expertise service's checks as rows: name and price from content/expert/pricing.yml,
// optionally with "you give / you get" copy merged in by the page.
import Icon from "./Icon.astro";
import { formatPrice, type ExpertCheckPrice } from "../lib/expertPricing";

interface Props {
  checks: (ExpertCheckPrice & { give?: string; get?: string })[];
  currency: string;
}
const { checks, currency } = Astro.props;
---

<ul class="rows checks">
  {
    checks.map((c) => (
      <li class="check">
        <Icon name={c.icon} size={28} class="ico" />
        <div class="body">
          <h3 class="row-title">{c.name}</h3>
          {(c.give || c.get) && (
            <dl>
              {c.give && (
                <div>
                  <dt class="label">You give</dt>
                  <dd>{c.give}</dd>
                </div>
              )}
              {c.get && (
                <div>
                  <dt class="label">You get</dt>
                  <dd>{c.get}</dd>
                </div>
              )}
            </dl>
          )}
          {c.note && <p class="label note">{c.note}</p>}
        </div>
        <p class="price">
          {formatPrice(c.price, currency)}
          <span class="label">per artifact</span>
        </p>
      </li>
    ))
  }
</ul>

<style>
  .check { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: .6rem 1.5rem; align-items: start; padding-block: 1.2rem 1.4rem; }
  .ico { color: var(--accent); margin-top: .2rem; }
  .body { display: flex; flex-direction: column; gap: .8rem; }
  dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 2rem; max-width: 62ch; }
  dl div { display: flex; flex-direction: column; gap: .3rem; }
  dd { margin: 0; color: var(--ink); }
  .note { text-transform: none; letter-spacing: 0; }
  .price { display: flex; flex-direction: column; align-items: flex-end; gap: .3rem; font-family: var(--display); font-weight: 900; font-size: clamp(2.4rem, 1.5rem + 3vw, 4rem); line-height: .85; color: var(--accent); font-variant-numeric: tabular-nums; }
  @media (max-width: 700px) {
    .check { grid-template-columns: auto minmax(0, 1fr); }
    .price { grid-column: 2; align-items: flex-start; }
    dl { grid-template-columns: 1fr; }
  }
</style>
