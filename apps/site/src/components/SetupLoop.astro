---
// One /setups flow: its lifecycle as one line of steps, stages bracketed over their steps,
// each step a node that opens a dialog with its write-up, tools and sources (content/setup.yml).
// The page draws one per flow, so every id here is prefixed with the flow's id.
//
// Every node's mark sits on one solid line: left to right from the desktop breakpoint up, top
// to bottom below it. There is no drawn way back; the signal drop shows the loop by jumping
// from the last step to the first.
//
// Rest state first: the track, the nodes and every dialog are in the HTML. The
// buttons open their dialogs with invoker commands (commandfor / command="show-modal"), which
// need no script; the script only polyfills them and adds the signal drop. The drop moves on
// the shared 14 fps clock, so it steps rather than glides, and it doesn't exist at all with
// reduced motion.
import { sourceUrl, COMMIT, REPO } from "../lib/setup";
import { KINDS, sortKinds, type Kind } from "../lib/setupKinds";
import Icon from "./Icon.astro";

type Step = { name: string; kinds: Kind[]; tools: string[]; body: string[]; sources: { label: string; path: string }[] };
interface Props {
  id: string;
  stages: { name: string; steps: Step[] }[];
}
const { id: flow, stages } = Astro.props;

const pad = (n: number) => String(n).padStart(2, "0");
const id = (si: number, ji: number) => `${flow}-step-${si + 1}-${ji + 1}`;
const short = COMMIT.slice(0, 7);
---

<div class="loop" data-loop>
  <span class="track" aria-hidden="true" data-track></span>
  <span class="drop" aria-hidden="true" data-drop></span>
  <ol class="stages">
    {
      stages.map((stage, si) => (
        <li class="stage" style={`--n: ${stage.steps.length}`}>
          <h3 class="stage-name label">
            <span class="stage-num">{pad(si + 1)}</span> {stage.name}
          </h3>
          <ol class="steps">
            {stage.steps.map((step, ji) => (
              <li>
                <button type="button" class="node" commandfor={id(si, ji)} command="show-modal" aria-haspopup="dialog" data-node>
                  <span class="mark" aria-hidden="true" data-mark />
                  <span class="kinds" aria-hidden="true">
                    {sortKinds(step.kinds).map((k) => <Icon name={KINDS[k].icon} size={16} />)}
                  </span>
                  <span class="node-name">{step.name}</span>
                  <span class="sr-only">({sortKinds(step.kinds).map((k) => KINDS[k].label).join(", ")})</span>
                </button>
              </li>
            ))}
          </ol>
        </li>
      ))
    }
  </ol>
</div>

{
  stages.map((stage, si) =>
    stage.steps.map((step, ji) => (
      <dialog id={id(si, ji)} class="step" aria-labelledby={`${id(si, ji)}-title`} closedby="any">
        <div class="step-body">
          <p class="label">
            {pad(si + 1)} · {stage.name}
          </p>
          <h2 id={`${id(si, ji)}-title`}>{step.name}</h2>
          {step.body.map((p) => (
            <p class="step-p">{p}</p>
          ))}
          <ul class="tags" aria-label="What does the work">
            {sortKinds(step.kinds).map((k) => (
              <li class="tag kind"><Icon name={KINDS[k].icon} size={14} /> {KINDS[k].label}</li>
            ))}
          </ul>
          <ul class="tags" aria-label="Tools">
            {step.tools.map((t) => (
              <li class="tag">{t}</li>
            ))}
          </ul>
          <h3 class="label">Source</h3>
          <ul class="sources">
            {step.sources.map((s) => (
              <li>
                <a href={sourceUrl(s.path)}>
                  <span class="src-label">{s.label}</span>
                  <span class="src-path">{s.path} on GitHub</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="label commit">
            At commit <a href={`${REPO}/commit/${COMMIT}`}>{short}</a>, the one this page was built from.
          </p>
          <button type="button" class="btn close" commandfor={id(si, ji)} command="close">Close</button>
        </div>
      </dialog>
    )),
  )
}

<style>
  .loop {
    --m: 14px;      /* node mark */
    --head: 3.5rem; /* stage label and bracket, above the line */
    position: relative;
  }
  /* The line the steps sit on. */
  .track {
    position: absolute; left: 0; right: 0; top: calc(var(--head) + var(--m) / 2 - .5px); height: 1px;
    background: var(--ink); pointer-events: none;
  }

  .stages { list-style: none; margin: 0; padding: 0 1.5rem; display: flex; gap: clamp(1rem, 2.5vw, 2rem); }
  .stage { flex: var(--n) 1 0; min-width: 0; display: flex; flex-direction: column; }
  .stage-name {
    position: relative; height: var(--head); margin: 0; padding-top: .2rem;
    color: var(--ink); white-space: nowrap;
  }
  /* The bracket over a stage's steps. */
  .stage-name::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: .65rem; height: .5rem;
    border: 1px solid var(--muted); border-bottom: 0;
  }
  .stage-num { color: var(--accent); }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; }
  .steps > li { flex: 1 1 0; display: flex; justify-content: center; min-width: 0; }

  .node {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: .75rem;
    background: none; border: 0; padding: 0 .25rem; margin: 0; color: inherit; font: inherit;
    text-align: center; cursor: pointer; max-width: 9rem;
  }
  .mark {
    width: var(--m); height: var(--m); flex: none;
    background: var(--paper); border: 1px solid var(--ink);
    transition: background-color .2s, border-color .2s;
  }
  .node:hover .mark, .node:focus-visible .mark { background: var(--ink); }
  .node[data-lit] .mark { background: var(--signal); border-color: var(--signal-edge); }
  /* What does the work, as small icons between the mark and the name. Muted, so the name and
     the signal drop stay the loudest things on the line. */
  .kinds { display: flex; gap: .3rem; color: var(--muted); }
  .kinds :global(svg) { display: block; }
  .kind { display: inline-flex; align-items: center; gap: .35rem; color: var(--ink); border-color: var(--ink); }
  .node-name { font: 800 clamp(.95rem, .55rem + .6vw, 1.15rem)/.95 var(--display); text-transform: uppercase; transition: color .2s; }
  /* The step the drop is on takes the terracotta accent, the same as hover and focus. */
  .node:hover .node-name, .node:focus-visible .node-name, .node[data-lit] .node-name { color: var(--accent); }

  .drop {
    position: absolute; left: 0; top: 0; width: 8px; height: 8px; margin: -4px 0 0 -4px;
    background: var(--signal); outline: 1px solid var(--signal-edge);
    pointer-events: none; display: none;
  }
  .loop[data-running] .drop { display: block; }

  /* Below the breakpoint the line turns down the left edge. */
  @media (max-width: 1099px) {
    .track { left: calc(var(--m) / 2 - .5px); right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .stages { flex-direction: column; gap: 2rem; padding: .5rem 0; }
    .stage { flex: none; gap: 1rem; }
    .stage-name { height: auto; padding: 0 0 0 calc(var(--m) + 1rem); display: flex; align-items: center; gap: .6rem; white-space: normal; }
    .stage-num { font: 900 1.75rem/1 var(--display); }
    /* On the line, a stage is a small filled square instead of a bracket. */
    .stage-name::after { left: calc(var(--m) / 2 - 3.5px); right: auto; top: 50%; bottom: auto; width: 7px; height: 7px; border: 0; background: var(--ink); transform: translateY(-50%); }
    .steps { flex-direction: column; gap: 1.25rem; }
    .steps > li { justify-content: flex-start; }
    .node { flex-direction: row; gap: 1rem; padding: 0; text-align: left; max-width: none; }
    /* The name leads on phones; the icons follow it. */
    .kinds { order: 1; }
    .node-name { font-size: var(--step-1); }
  }

  /* The dialog. A panel, like everything that carries its own content: square, hairline, no
     shadow. The backdrop dims the page with the paper colour rather than a blur. */
  .step {
    width: min(40rem, calc(100vw - 32px)); max-height: min(44rem, calc(100dvh - 32px));
    padding: 0; border: 1px solid var(--ink); background: var(--paper); color: var(--ink);
  }
  .step::backdrop { background: color-mix(in srgb, var(--paper) 82%, transparent); }
  .step-body { padding: clamp(1.25rem, 4vw, 2.25rem); display: flex; flex-direction: column; gap: 1rem; }
  .step-body > * { margin: 0; }
  .step h2 { font-size: var(--step-2); line-height: .9; }
  .step-p { line-height: 1.55; }
  .step h3 { margin-top: .5rem; }
  .sources { list-style: none; padding: 0; border-top: 2px solid var(--ink); }
  .sources li { border-bottom: 1px solid var(--line); }
  .sources a { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1rem; padding: .7rem 0; text-decoration: none; color: inherit; }
  .src-label { font-family: var(--display); font-weight: 800; font-size: var(--step-0); text-transform: uppercase; }
  .src-path { font: var(--step--1)/1.4 var(--mono); color: var(--muted); overflow-wrap: anywhere; }
  .sources a:hover .src-label, .sources a:focus-visible .src-label { color: var(--accent); }
  .commit a { color: var(--accent); }
  .close { align-self: flex-start; margin-top: .5rem; }
  :global(html:has(dialog.step[open])) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .mark, .node-name { transition: none; }
  }
</style>

<script>
  import { reduce } from "../scripts/signal.js";

  // Invoker commands where the browser lacks them, and light dismiss where closedby="any"
  // isn't supported: a click that lands on the dialog itself rather than its body is a click
  // on the backdrop.
  if (!("command" in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>("button[commandfor]").forEach((b) =>
      b.addEventListener("click", () => {
        const d = document.getElementById(b.getAttribute("commandfor")!) as HTMLDialogElement | null;
        if (!d) return;
        if (b.getAttribute("command") === "show-modal") d.showModal();
        else d.close();
      }),
    );
  }
  document.querySelectorAll<HTMLDialogElement>("dialog.step").forEach((d) =>
    d.addEventListener("click", (e) => e.target === d && d.close()),
  );

  // The signal drop: one dot running along the line, pausing on each node it reaches and
  // lighting it, then jumping from the last node back to the first. Positions are distances
  // along the line: x on desktop, y on phones, whichever way the line runs.
  const FRAME = 71;      // the shared 14 fps clock (src/scripts/signal.js, GLITCH.frameMs)
  const SPEED = 120;     // px per second along the line
  const DWELL = 6;       // frames held on a node, ~430 ms
  const LIT = 700;       // ms a node stays lit

  // One drop per flow, each on its own line.
  if (!reduce) document.querySelectorAll<HTMLElement>("[data-loop]").forEach((loop) => {
    const track = loop.querySelector<HTMLElement>("[data-track]")!;
    const drop = loop.querySelector<HTMLElement>("[data-drop]")!;
    const nodes = [...loop.querySelectorAll<HTMLElement>("[data-node]")];
    let ox = 0, oy = 0, down = false, ready = false;
    let at: number[] = [];
    let t = 0, hold = 0, timer = 0;

    const measure = () => {
      const r = track.getBoundingClientRect(), l = loop.getBoundingClientRect();
      down = r.height > r.width;
      ox = r.left - l.left + r.width / 2; oy = r.top - l.top + r.height / 2;
      at = nodes.map((n) => {
        const b = n.querySelector("[data-mark]")!.getBoundingClientRect();
        return down ? b.top + b.height / 2 - r.top - r.height / 2 : b.left + b.width / 2 - r.left - r.width / 2;
      });
      ready = at.length > 1;
      t = at[0]; hold = DWELL;
      light(0);
      draw();
    };
    const draw = () => {
      drop.style.transform = down ? `translate(${ox}px, ${oy + t}px)` : `translate(${ox + t}px, ${oy}px)`;
    };
    const light = (i: number) => {
      const n = nodes[i];
      n.dataset.lit = "";
      clearTimeout((n as any)._lit);
      (n as any)._lit = setTimeout(() => delete n.dataset.lit, LIT);
    };
    const tick = () => {
      if (!ready) return;
      if (hold > 0) { hold--; return; }
      // The next node ahead; after the last one, that's the first, and the drop jumps there.
      const next = at.findIndex((s) => s > t + 0.5);
      if (next < 0) {
        t = at[0];
        hold = DWELL; light(0);
      } else if (at[next] - t <= (SPEED * FRAME) / 1000) {
        t = at[next];
        hold = DWELL; light(next);
      } else {
        t += (SPEED * FRAME) / 1000;
      }
      draw();
    };
    const run = (on: boolean) => {
      clearInterval(timer);
      if (on) timer = window.setInterval(tick, FRAME);
      loop.toggleAttribute("data-running", on);
    };

    new ResizeObserver(measure).observe(loop);
    let visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; run(visible && !document.hidden); }).observe(loop);
    document.addEventListener("visibilitychange", () => run(visible && !document.hidden));
  });
</script>
