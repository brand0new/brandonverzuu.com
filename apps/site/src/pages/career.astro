---
// /career: Brandon's working history from content/career.yml. PageHead, an In numbers block,
// then the chapters: why, the timeline, certifications and skills. Every number is
// counted from the data at build time, never typed in.
import { existsSync } from "node:fs";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import CareerEmployer from "../components/CareerEmployer.astro";
import { SITE, plural } from "../lib/content";
import { breadcrumbSchema, type Crumb } from "../lib/schema";
import { currentMonth, employerSpan, formatMonth, monthsBetween } from "../lib/career";

const entry = await getEntry("career", "career");
if (!entry) throw new Error("content/career.yml is missing");
const career = entry.data;

// Build-time "now": the site is rebuilt on every merge, so a current role's duration is at
// most one deploy stale, and the prerendered page never disagrees with itself.
const now = currentMonth();
const recent = career.employers.filter((e) => !e.early);
const early = career.employers.filter((e) => e.early);

const firstStart = career.employers.flatMap((e) => e.roles.map((r) => r.start)).sort()[0]!;
const years = Math.floor(monthsBetween(firstStart, now) / 12);
const current = recent.flatMap((e) => e.roles.filter((r) => !r.end).map((r) => ({ employer: e.name, role: r })))[0];
const earlySpans = early.map(employerSpan);
const earlyYears = `${earlySpans.map((s) => s.start).sort()[0]?.slice(0, 4)}–${earlySpans.map((s) => s.end ?? now).sort().at(-1)?.slice(0, 4)}`;

const facts = [
  { value: years, label: `Years since my first job, ${firstStart.slice(0, 4)}`, drop: true },
  { value: career.employers.length, label: "Employers" },
  { value: recent[0]!.roles.length, label: `Roles at ${recent[0]!.name}` },
];

// Certifications sit under their issuer, like roles under an employer, in the order the data
// lists them. An issuer without a badge image gets a monogram: the initials of its
// capitalised words, "The" left out ("The Linux Foundation" is LF).
const issuers = [...new Set(career.certifications.map((c) => c.issuer))].map((issuer) => {
  const certs = career.certifications.filter((c) => c.issuer === issuer);
  const badge = certs.find((c) => c.badge)?.badge;
  if (badge && !existsSync(new URL(`../../public${badge}`, import.meta.url))) {
    throw new Error(`content/career.yml: badge ${badge} is not in public/`);
  }
  const monogram = issuer.split(/\s+/).filter((w) => /^[A-Z]/.test(w) && w !== "The").map((w) => w[0]).join("").slice(0, 2);
  return { issuer, certs, badge, monogram };
});
const skillCount = career.skills.reduce((n, g) => n + g.items.length, 0);

const description = "My path from SharePoint intern to Head of Innovation & Product: integration, APIs and turning a vision into products and services.";
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Career" }];
---

<Base image="/og/career.png" title="Career | Brandon Verzuu" description={description} schema={[breadcrumbSchema(crumbs, `${SITE}/career`)]}>
  <PageHead title="Career" crumbs={crumbs} kicker={current ? `${current.role.title} · ${current.employer} · ${career.location}` : career.location} description={career.intro[0]} />

  <section class="wrap section" aria-label="In numbers">
    <ul class="numbers">
      {
        facts.map((f) => (
          <li>
            <span class="num">
              {f.value}
              {f.drop && <span class="drop" aria-hidden="true" />}
            </span>
            <span class="label">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="chapter wrap" aria-labelledby="why-title">
    <div class="chapter-head">
      <p class="label">01 · Why</p>
      <h2 id="why-title">Find the vision<br />again</h2>
      <div class="measure stack">{career.intro.slice(1).map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="chapter wrap" aria-labelledby="timeline-title">
    <div class="chapter-head">
      <p class="label">02 · Timeline</p>
      <h2 id="timeline-title">From SharePoint<br />to strategy</h2>
      <p class="measure">Newest first. Roles at one company sit together under its name.</p>
    </div>
    <ol class="rows">
      {
        recent.map((e) => (
          <li>
            <CareerEmployer employer={e} now={now} />
          </li>
        ))
      }
    </ol>
    {
      early.length > 0 && (
        <details class="early">
          {/* Native <details>: collapsible without a script, keyboard and screen-reader
              support for free, and the text is still in the prerendered HTML. */}
          <summary class="more">Early career &amp; studies · {earlyYears}</summary>
          <ol class="rows">
            {early.map((e) => (
              <li>
                <CareerEmployer employer={e} now={now} />
              </li>
            ))}
          </ol>
        </details>
      )
    }
  </section>

  <section class="chapter wrap" aria-labelledby="certs-title">
    <div class="chapter-head">
      <p class="label">03 · Certifications</p>
      <h2 id="certs-title">Proof of<br />learning</h2>
      <p class="measure">{plural(career.certifications.length, "certification")} from {plural(issuers.length, "issuer")}, grouped by who issued them. Where an issuer offers one, the name links to its verification.</p>
    </div>
    <ol class="rows">
      {
        issuers.map((i) => (
          <li class="issuer">
            {i.badge ? (
              <img class="badge" src={i.badge} alt="" width="64" height="64" loading="lazy" />
            ) : (
              <span class="badge mono" aria-hidden="true">{i.monogram}</span>
            )}
            <div>
              <h3 class="issuer-name">{i.issuer}</h3>
              <ul class="certs">
                {i.certs.map((c) => (
                  <li>
                    {c.url ? <a href={c.url}>{c.name}</a> : <span>{c.name}</span>}
                    <span class="label">{formatMonth(c.date)}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="chapter wrap" aria-labelledby="skills-title">
    <div class="chapter-head">
      <p class="label">04 · Skills</p>
      <h2 id="skills-title">What I<br />bring</h2>
      <p class="measure">{plural(skillCount, "skill")}, grouped by where I use them.</p>
    </div>
    <ol class="skills">
      {
        career.skills.map((g, i) => (
          <li class="skill-group">
            <header class="skill-head">
              <span class="label">{String(i + 1).padStart(2, "0")}</span>
              <h3>{g.group}</h3>
              <span class="label">{g.items.length}</span>
            </header>
            <ul class="skill-items">
              {g.items.map((s) => <li>{s}</li>)}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>

</Base>

<script>
  import { observeLockOn } from "../scripts/signal.js";
  observeLockOn([...document.querySelectorAll<HTMLElement>(".numbers .drop")]);
</script>

<style>
  /* In numbers (design system: InNumbers): a 2px ink rule, columns split by hairlines,
     stacked on phones. One signal drop, after the figure that matters most. */
  .numbers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .numbers li { display: flex; flex-direction: column; gap: .6rem; padding: 1.4rem 1.4rem 1.4rem 0; }
  .numbers li + li { border-left: 1px solid var(--line); padding-left: 1.4rem; }
  .num { font-family: var(--display); font-weight: 900; font-size: clamp(4rem, 3rem + 5vw, 7rem); line-height: .8; color: var(--accent); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .numbers { grid-template-columns: minmax(0, 1fr); }
    .numbers li + li { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); }
  }
  /* Certifications: one row per issuer, its badge in a square on the left. The monogram is
     the badge's rest state: display face, accent hairline, square corners. */
  .issuer { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.4rem; padding-block: 1.2rem; }
  .badge { width: 4rem; height: 4rem; object-fit: contain; }
  .badge.mono { display: grid; place-items: center; border: 2px solid var(--accent); color: var(--accent); font-family: var(--display); font-weight: 900; font-size: 1.7rem; line-height: 1; text-transform: uppercase; }
  .issuer-name { margin: 0 0 .6rem; font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: var(--step-1); line-height: .95; }
  .certs { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .45rem; max-width: 62ch; }
  .certs li { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .2rem 1rem; }
  /* Skills: one panel per group in a grid under the 2px ink rule. Each panel opens with its
     index, the group name in the display face and a count, then the skills as a readable
     serif list with accent markers, instead of a wall of small mono tags. */
  .skills { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: 0 2.5rem; border-top: 2px solid var(--ink); }
  .skill-group { padding-block: 1.3rem 1.6rem; border-bottom: 1px solid var(--line); }
  .skill-head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: .8rem; padding-bottom: .9rem; margin-bottom: .9rem; border-bottom: 1px solid var(--line); }
  .skill-head h3 { font-size: var(--step-1); line-height: .95; }
  .skill-head .label:first-child { color: var(--accent); }
  .skill-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .35rem; font-size: var(--step--1); line-height: 1.4; }
  .skill-items li { display: grid; grid-template-columns: .45rem minmax(0, 1fr); gap: .7rem; align-items: baseline; }
  .skill-items li::before { content: ""; width: .45rem; height: .45rem; background: var(--accent); transform: translateY(-.1em); }
  .early { margin-top: 1rem; }
  .early summary { cursor: pointer; color: var(--accent); padding-block: .6rem; width: fit-content; }
  .early[open] summary { margin-bottom: 1.5rem; }
</style>
