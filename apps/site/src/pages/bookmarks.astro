---
// No favicons: they'd come from a third-party service at request time, and the list reads
// fine as text.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";

const description = "Here's some interesting stuff I've found on the internet.";
const bookmarks = [
  { label: "An Open Source, Privacy first set of developer tools", url: "https://devtoys.app" },
  { label: "A comprehensive view of all stakeholders creating the programmable economy", url: "https://apilandscape.apiscene.io" },
  { label: "An online and interactive view of the bitcoin ecosystem", url: "https://mempool.space/" },
  { label: "A self hosted network-wide ad blocker", url: "https://pi-hole.net/" },
  { label: "Create and host your own cloud", url: "https://umbrel.com" },
  { label: "A free fonts service launched by the Indian Type Foundry (ITF)", url: "https://fontshare.com" },
  { label: "Industrial strength, enterprise grade, beautiful dev tools for code hackers.", url: "https://pb33f.io" },
  { label: "A helpful tool to determine scale for your Typography", url: "https://typescale.com" },
  { label: "Opensource solution for working with API descriptions", url: "https://github.com/speclynx" },
  { label: "Agent solution of choice", url: "https://hermes-agent.nousresearch.com/" },
  { label: "Opensource Digital Signage to display", url: "https://anthias.screenly.io/" },
];
const host = (u: string) => new URL(u).host.replace(/^www\./, "");
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base title="Bookmarks | Brandon Verzuu" description={description}>
  <PageHead title="Bookmarks" description={description} />
  <div class="wrap section">
    <ol class="rows">
      {
        bookmarks.map((b, i) => (
          <li>
            <a class="row bm" href={b.url}>
              <span class="n" aria-hidden="true">{pad(i + 1)}</span>
              <span class="body">
                <span class="host">{host(b.url)}</span>
                <span class="row-desc">{b.label}</span>
              </span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Base>

<style>
  .bm { grid-template-columns: 3rem minmax(0, 1fr) auto; align-items: baseline; }
  .n { font-family: var(--mono); color: var(--accent); font-variant-numeric: tabular-nums; }
  .body { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
  .host { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.5rem, 1rem + 2vw, 2.4rem); line-height: .95; overflow-wrap: anywhere; }
  .bm:hover .host, .bm:focus-visible .host { color: var(--accent); }
  .arrow { font-family: var(--mono); color: var(--muted); }
</style>
