---
// How this site gets built and shipped, as one diagram (src/components/SetupLoop.astro). The
// stages, steps and copy live in content/setup.yml, so the page itself only frames it.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SetupLoop from "../components/SetupLoop.astro";
import { SITE } from "../lib/content";
import { breadcrumbSchema, type Crumb } from "../lib/schema";

const setup = (await getEntry("setup", "setup"))!.data;
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Setup" }];
---

<Base image="/og/setup.png" title="Setup | Brandon Verzuu" description={setup.intro} schema={[breadcrumbSchema(crumbs, `${SITE}/setup`)]}>
  <PageHead title="Setup" crumbs={crumbs} description={setup.intro} />
  <div class="wrap section">
    <SetupLoop stages={setup.stages} />
  </div>
</Base>
