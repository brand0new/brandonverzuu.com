---
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import CheckRows from "../../components/CheckRows.astro";
import Icon from "../../components/Icon.astro";
import type { CheckKind } from "../../lib/expertPricing";

const pricing = (await getEntry("expertPricing", "pricing"))!.data;

// What goes in and what comes out, per check (docs/specs/expert-mcp/README.md). Names and
// prices come from content/expert/pricing.yml.
const descriptions: Record<CheckKind, { give: string; get: string }> = {
  "api-governance": {
    give: "An OpenAPI 3.0 or 3.1 document.",
    get: "Findings with a severity, the JSONPath where they apply, the issue and a fix, plus a governance score per dimension.",
  },
  "skill-design": {
    give: "An Agent Skill folder: SKILL.md and the files next to it.",
    get: "Findings on structure, triggering, scope, progressive disclosure and safety, by file and line, plus a score.",
  },
  "process-review": {
    give: "A process description in the published process format.",
    get: "Findings on roles, handoffs, controls, exceptions and measurability, plus a score.",
  },
};
const checks = pricing.checks.map((c) => ({ ...c, ...descriptions[c.kind] }));

const ways = [
  {
    name: "MCP, for agents",
    icon: "mage:robot-fill",
    text: "Sign in with OAuth and the server offers the checks as tools, with skills that tell your agent when to use them.",
    example: "https://mcp.brandonverzuu.com/mcp",
  },
  {
    name: "The CLI, for people and coding agents",
    icon: "mage:keyboard-fill",
    text: "bv-expertise, from the npm package @brandonverzuu/expertise. It validates your file locally first, so a malformed one never costs anything, and writes text, JSON, SARIF or Markdown.",
    example: "bv-expertise check api openapi.yaml",
  },
  {
    name: "REST, for CI",
    icon: "mage:dashboard-check-fill",
    text: "The same checks over HTTP with an account API token. In a pipeline the CLI does this for you, can fail the build on errors, and its SARIF output shows findings in GitHub code scanning.",
    example: "POST /v1/checks/{kind}",
  },
];
---

<Base title="Expertise | Brandon Verzuu" description="Paid, agent-callable checks for OpenAPI documents, Agent Skills and process descriptions, by Brandon Verzuu. Coming soon.">
  <PageHead title="Expertise" kicker="Coming soon">
    <p>When I review an API specification, an agent skill or a process description, I check it against standards I've written down for myself. This service turns those checks into something your agent or CI pipeline can call: you send an artifact and get back the findings I'd give an employer or client.</p>
    <p>The answers come from rules I wrote and maintain, not from a language model, so the same input gets the same result. Nothing is live yet: this page describes what I'm building, and details may still change.</p>
  </PageHead>

  <section class="wrap section" aria-labelledby="checks-heading">
    <h2 id="checks-heading">Three checks</h2>
    <CheckRows checks={checks} currency={pricing.currency} />
    <p class="label">Planned prices in euros, excluding VAT.</p>
  </section>

  <section class="wrap section" aria-labelledby="ways-heading">
    <h2 id="ways-heading">Three ways in</h2>
    <ol class="ways">
      {
        ways.map((w, i) => (
          <li>
            <span class="n" aria-hidden="true">0{i + 1}</span>
            <Icon name={w.icon} size={28} class="ico" />
            <h3>{w.name}</h3>
            <p>{w.text}</p>
            <code>{w.example}</code>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section" aria-labelledby="prep-heading">
    <h2 id="prep-heading">Skills and the process format</h2>
    <div class="prose">
      <p>Public skills tell your agent when a check is worth running, how to prepare the input and how to read the result. They don't contain the rules. They'll be published in this site's <a href="https://github.com/brand0new/brandonverzuu.com">public repository</a> and served over MCP.</p>
      <!-- TODO: link the schema once /schemas/process-description/v1.json exists (spec 04 builds it in packages/check-kit; spec 07 serves it). -->
      <p>The process review needs your process in a structured format. I'm publishing it as a JSON Schema at <code>/schemas/process-description/v1.json</code>. The skill helps your agent turn a prose description into it, and asks you for anything that's missing instead of making it up.</p>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="paying-heading">
    <h2 id="paying-heading">Paying per check</h2>
    <div class="prose">
      <p>You pay for each check as you run it. There are no packs and no balance. You see the price for your file first, and a check that fails on my side isn't charged.</p>
      <p>Payment goes with the request itself: over x402, in EURC or USDC from a wallet linked to your account, or over Stripe's Machine Payments Protocol in euros. Your agent or the CLI asks you before it pays. There's no free trial.</p>
    </div>
    <p class="more"><a href="/expert/pricing">Pricing →</a> · <a href="/expert/terms">Terms →</a> · <a href="/expert/privacy">Privacy →</a></p>
  </section>
</Base>

<style>
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .ways li { display: flex; flex-direction: column; gap: .8rem; padding: 1.2rem 1.4rem 1.4rem 0; min-width: 0; }
  .ways li + li { border-left: 1px solid var(--line); padding-left: 1.4rem; }
  .n { font-family: var(--mono); color: var(--accent); }
  .ico { color: var(--accent); }
  h3 { font-size: var(--step-1); line-height: 1; }
  code { font-family: var(--mono); font-size: .82rem; background: var(--panel); padding: .4rem .55rem; overflow-wrap: anywhere; margin-top: auto; }
  @media (max-width: 860px) { .ways { grid-template-columns: 1fr; } .ways li + li { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); } }
</style>
