---
import { getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import CheckRows from "../../components/CheckRows.astro";
import { SITE } from "../../lib/content";
import { breadcrumbSchema, type Crumb } from "../../lib/schema";

const pricing = (await getEntry("expertPricing", "pricing"))!.data;
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Expertise", href: "/expert" }, { label: "Pricing" }];
---

<Base title="Pricing | Expertise | Brandon Verzuu" description="Prices per check for Brandon Verzuu's expertise service, paid per request over x402 or Stripe. Coming soon." schema={[breadcrumbSchema(crumbs, `${SITE}/expert/pricing`)]}>
  <PageHead title="Pricing" crumbs={crumbs}>
    <p>You pay per check, each time you run one. There are no packs, no balance and no subscription, and there's no free trial. These are the planned prices, and they may still change before the service goes live.</p>
  </PageHead>

  <section class="wrap section" aria-labelledby="checks-heading">
    <h2 id="checks-heading">Price per check</h2>
    <CheckRows checks={pricing.checks} currency={pricing.currency} />
    <p class="label">Prices in euros, excluding VAT. You see the exact price for your file before anything is charged, and a check that fails on my side isn't charged at all.</p>
  </section>

  <section class="wrap section" aria-labelledby="paying-heading">
    <h2 id="paying-heading">How you pay</h2>
    <div class="prose">
      <p>Each check is paid on the request itself, in one of two ways. Your agent or the CLI asks you before it pays.</p>
      <ul>
        <li><strong>x402</strong>, in EURC or USDC on Base, from a wallet you've linked to your account. Payments on a blockchain are public.</li>
        <li><strong>Stripe's Machine Payments Protocol</strong>, in euros, if you'd rather not use a crypto wallet.</li>
      </ul>
      <p>Every month you get a statement of all your payments, with VAT.</p>
    </div>
    <p class="more"><a href="/expert/terms">Terms →</a> · <a href="/expert/privacy">Privacy →</a></p>
  </section>
</Base>
