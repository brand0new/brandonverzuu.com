---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import BinaryIcon from "../../components/BinaryIcon.astro";
import { clusterStats, plural } from "../../lib/content";

const description = "My writing organised by theme rather than publish date — cloud integration and API governance, AI and trust, and blockchain, each grouped into one place.";
const clusters = await clusterStats();
---

<Base title="Topics | Brandon Verzuu" description={description}>
  <PageHead title="Topics" description={description} />
  <div class="wrap section">
    <ul class="rows">
      {
        clusters.map((c) => (
          <li>
            <a class="row topic" href={`/topics/${c.slug}`}>
              <BinaryIcon keyword={c.binaryKeyword} size=".62rem" />
              <span class="body">
                <span class="row-title">{c.title}</span>
                <span class="row-desc">{c.summary}</span>
              </span>
              <span class="row-meta">
                {plural(c.count, "article")}
                {c.years && <><br />{c.years}</>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .topic { grid-template-columns: auto minmax(0, 1fr) auto; align-items: start; gap: .6rem 1.5rem; }
  .body { display: flex; flex-direction: column; gap: .6rem; }
  @media (max-width: 640px) { .topic { grid-template-columns: auto minmax(0, 1fr); } .topic .row-meta { grid-row: auto; grid-column: 2; } }
</style>
