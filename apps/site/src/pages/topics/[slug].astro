---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ArticleRows from "../../components/ArticleRows.astro";
import BinaryIcon from "../../components/BinaryIcon.astro";
import { topicClusters, type TopicCluster } from "../../lib/topicClusters";
import { publishedArticles, inCluster, plural, SITE } from "../../lib/content";
import { breadcrumbSchema, collectionSchema, type Crumb } from "../../lib/schema";

export function getStaticPaths() {
  return topicClusters.map((cluster) => ({ params: { slug: cluster.slug }, props: { cluster } }));
}

const { cluster } = Astro.props as { cluster: TopicCluster };
const articles = (await publishedArticles()).filter((a) => inCluster(a, cluster));
const url = `${SITE}/topics/${cluster.slug}`;
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Topics", href: "/topics" }, { label: cluster.title }];
const schema = [
  collectionSchema({ title: cluster.title, description: cluster.summary, url, items: articles.map((a) => ({ title: a.data.title, url: `${SITE}/articles/${a.id}` })) }),
  breadcrumbSchema(crumbs, url),
];
---

<Base title={`${cluster.title} | Brandon Verzuu`} description={cluster.summary} schema={schema}>
  <PageHead title={cluster.title} crumbs={crumbs}>
    <div class="intro">
      <BinaryIcon keyword={cluster.binaryKeyword} size=".8rem" />
      <p>{cluster.intro}</p>
    </div>
  </PageHead>
  <div class="wrap section">
    <h2 class="label">{plural(articles.length, "article")} in this topic</h2>
    {articles.length ? <ArticleRows articles={articles} /> : <p class="label">No articles in this topic yet.</p>}
  </div>
</Base>

<style>
  .intro { display: flex; gap: 1.5rem; align-items: flex-start; }
  .intro p { font-size: var(--step-0); line-height: 1.6; color: var(--ink); max-width: 62ch; }
</style>
