---
// Filtering is client-side on this one page rather than a page per medium: there are few
// reviews per medium, and thin category pages would do more harm than good for SEO. The
// chips only appear once there are two media to choose between.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ReviewRating from "../../components/ReviewRating.astro";
import { publishedReviews, formatDate, isoDate } from "../../lib/content";
import { media, type ReviewMedium } from "../../lib/reviews";

const description = "What I thought of the films, series, games and books I've spent time with lately, each scored out of ten.";
const reviews = await publishedReviews();
// In the order declared in src/lib/reviews.ts, so the chips don't reshuffle when a review is added.
const available = (Object.keys(media) as ReviewMedium[]).filter((m) => reviews.some((r) => r.data.medium === m));
---

<Base title="Reviews | Brandon Verzuu" description={description}>
  <PageHead title="Reviews" description={description} />
  <div class="wrap section">
    {
      available.length > 1 && (
        <div class="filters" role="group" aria-label="Filter reviews by medium">
          <button type="button" class="btn" data-medium="" aria-pressed="true">All</button>
          {available.map((m) => (
            <button type="button" class="btn" data-medium={m} aria-pressed="false">
              {media[m].plural}
            </button>
          ))}
        </div>
      )
    }
    {
      reviews.length ? (
        <ul class="rows">
          {reviews.map((r) => (
            <li data-medium={r.data.medium}>
              <a class="row review" href={`/reviews/${r.id}`}>
                <ReviewRating rating={r.data.rating} />
                <span class="body">
                  <span class="label">
                    {[media[r.data.medium].label, r.data.subject.year].filter(Boolean).join(" · ")} · <time datetime={isoDate(r.data.date)}>{formatDate(r.data.date)}</time>
                  </span>
                  <span class="row-title">{r.data.title}</span>
                  <span class="row-desc">{r.data.verdict}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="label">No reviews yet.</p>
      )
    }
  </div>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filters button");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const m = b.dataset.medium;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      document.querySelectorAll<HTMLElement>(".rows > li").forEach((li) => (li.hidden = !!m && li.dataset.medium !== m));
    }),
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: .5rem; }
  .review { grid-template-columns: auto minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .body { display: flex; flex-direction: column; gap: .5rem; }
</style>
