---
// The story template. Markdown and frontmatter stay exactly as they are; the template adds a
// cover beside the billboard title that docks above the chapter rail and resolves as the
// reader reads, a chapter rail from the article's own h2s, and the explainer at the top of
// the text. Story blocks in the
// markdown (src/plugins/remark-story.mjs) add pull quotes, sidenotes and resolving figures.
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResolvingCover from "../../components/ResolvingCover.astro";
import StoryEnhance from "../../components/StoryEnhance.astro";
import { publishedArticles, covers, readingMinutes, formatDate, isoDate, language, SITE, type Article } from "../../lib/content";
import { articleSchema, breadcrumbSchema, type Crumb } from "../../lib/schema";
import { explainerHtml } from "../../lib/explainer.mjs";
import "../../styles/story.css";

export async function getStaticPaths() {
  const all = await publishedArticles();
  return all.map((a, i) => ({ params: { slug: a.id }, props: { article: a, newer: all[i - 1], older: all[i + 1] } }));
}

const { article, newer, older } = Astro.props as { article: Article; newer?: Article; older?: Article };
const d = article.data;
const { Content, headings, remarkPluginFrontmatter } = await render(article);
const chapters = headings.filter((h) => h.depth === 2);
const explainerTop = d.explainerVideo && !remarkPluginFrontmatter.explainerInline;
const c = covers("articles", article.id);
const min = readingMinutes(article);
const lang = language(article);
const url = `${SITE}/articles/${article.id}`;
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Articles", href: "/articles" }, { label: d.title }];
const schema = [articleSchema({ title: d.title, description: d.description, url, date: d.date, image: d.image, tags: d.tags }), breadcrumbSchema(crumbs, url)];
---

<Base title={`${d.title} | Brandon Verzuu`} description={d.description} image={d.image} schema={schema} type="article">
  <article class="story" lang={lang}>
    <header class="a-head wrap">
      <Breadcrumb crumbs={crumbs} />
      <div class="a-hero">
        <ResolvingCover dock dark={c.dark} light={c.light} credit={{ author: d.imageAuthor, source: d.imageSource, license: d.imageLicense }} />
        <div class="a-title">
          <p class="label">
            <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time> · {min} min read
          </p>
          <h1>{d.title}</h1>
          <p class="lede">{d.description}</p>
          {
            (d.tags ?? []).length > 0 && (
              <ul class="tags" aria-label="Tags">
                {(d.tags ?? []).map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </header>

    <div class="a-grid wrap">
      <aside class="rail">
        <div class="a-dock" data-cover-dock aria-hidden="true"></div>
        <span class="label a-dock-out" data-cover-out="cols" aria-hidden="true">Noise</span>
        {
          chapters.length > 0 && (
            <nav aria-label="Chapters">
              <p class="label">Chapters</p>
              <ol>
                {chapters.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
      <div class="a-body">
        {explainerTop && <div class="a-explainer" set:html={explainerHtml(d)} />}
        <div class="prose dropcap" data-cover-progress>
          <Content />
        </div>
        <nav class="a-next" aria-label="More articles">
          {newer && <a href={`/articles/${newer.id}`}><span class="label">Newer</span><span class="t">{newer.data.title}</span></a>}
          {older && <a href={`/articles/${older.id}`}><span class="label">Older</span><span class="t">{older.data.title}</span></a>}
        </nav>
      </div>
    </div>
  </article>
  <StoryEnhance />
</Base>
