---
// The workflows I use, each as its own diagram (src/components/SetupLoop.astro) under its own
// heading. The flows, stages, steps and copy live in content/setup.yml, so the page itself only
// frames them.
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SetupLoop from "../components/SetupLoop.astro";
import Icon from "../components/Icon.astro";
import { KINDS } from "../lib/setupKinds";
import { SITE } from "../lib/content";
import { breadcrumbSchema, type Crumb } from "../lib/schema";

const setup = (await getEntry("setup", "setup"))!.data;
const pad = (n: number) => String(n).padStart(2, "0");
const crumbs: Crumb[] = [{ label: "Home", href: "/" }, { label: "Setups" }];
---

<Base image="/og/setups.png" title="Setups | Brandon Verzuu" description={setup.intro} schema={[breadcrumbSchema(crumbs, `${SITE}/setups`)]}>
  <PageHead title="Setups" crumbs={crumbs} description={setup.intro} />
  {/* The key to the icons on every step: what does the work. */}
  <div class="wrap">
    <ul class="key label" aria-label="Key: what does the work">
      {Object.values(KINDS).map((k) => (
        <li><Icon name={k.icon} size={16} /> {k.label}</li>
      ))}
    </ul>
  </div>
  {
    setup.flows.map((flow, fi) => (
      <section id={flow.id} class="chapter wrap flow" aria-labelledby={`${flow.id}-title`}>
        <div class="chapter-head">
          <p class="label">{pad(fi + 1)} · Flow</p>
          <h2 id={`${flow.id}-title`}>{flow.name}</h2>
          <p class="measure">{flow.description}</p>
        </div>
        <SetupLoop id={flow.id} stages={flow.stages} />
      </section>
    ))
  }
</Base>

<style>
  .key { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; list-style: none; margin: 0; padding: 0; color: var(--muted); }
  .key li { display: inline-flex; align-items: center; gap: .4rem; }
  .flow { display: flex; flex-direction: column; gap: clamp(2rem, 4vw, 3rem); }
</style>
