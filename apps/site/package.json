    "playwright": "1.65.0",
    "sharp": "^0.35.5",
    "wrangler": "^4.159.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/mage": "^1.2.4",
    "astro": "^7.4.8",
    "cookie": "^2.0.1",
    "opentype.js": "^1.3.4",
    "remark-directive": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "type": "module"
