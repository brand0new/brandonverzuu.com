{
  "name": "@brandonverzuu/site",
  "version": "1.4.1",
  "description": "My personal website, built with Astro as a static build tool",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "host": "astro dev --host",
    "generate": "node scripts/check-contrast.mjs && astro build && node scripts/check-urls.mjs",
    "preview": "astro preview",
    "cover:generate": "node scripts/generate-cover.mjs",
