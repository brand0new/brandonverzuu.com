# Cloudflare Pages headers. /_astro/ holds the build's content-hashed CSS, JS and fonts,
# so a file there never changes once published.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=600, must-revalidate
